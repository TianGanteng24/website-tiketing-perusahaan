<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - IT Portal & Asset</title>
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #334155;
        }
        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
        }
        .form-control {
            border-radius: 8px;
            padding: 0.75rem 1rem;
            font-size: 0.9rem;
        }
        .form-control:focus {
            box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.15);
        }
        .btn-primary {
            border-radius: 8px;
            padding: 0.75rem;
            font-weight: 500;
        }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-4">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-dark text-white rounded-circle p-3 mb-2 shadow-sm" style="width: 54px; height: 54px;">
                        <i class="bi bi-cpu-fill fs-4 text-primary"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-1">IT Portal & Asset</h4>
                    <p class="text-muted small">Silakan masuk menggunakan akun kantor Anda</p>
                </div>

                <div class="card p-4">
                    <% if (error) { %>
                        <div class="alert alert-danger py-2 small border-0 bg-danger bg-opacity-10 text-danger mb-3">
                            <i class="bi bi-exclamation-circle me-1"></i> <%= error %>
                        </div>
                    <% } %>
                    <form action="/login" method="POST">
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Email Kantor</label>
                            <input type="email" name="email" class="form-control" placeholder="nama@perusahaan.com" required>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold small">Password</label>
                            <input type="password" name="password" class="form-control" placeholder="••••••••" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 shadow-sm">Masuk ke Portal</button>
                    </form>
                    <div class="text-center mt-4 pt-2 border-top small text-muted">
                        Belum punya akun? <a href="/register" class="text-decoration-none fw-semibold text-primary">Daftar di sini</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>