<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Buat Tiket IT Support</title>
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #334155;
        }
        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }
        .form-control, .form-select {
            border-radius: 8px;
            padding: 0.65rem 1rem;
            font-size: 0.9rem;
        }
        .form-control:focus, .form-select:focus {
            box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.15);
        }
        .btn {
            font-weight: 500;
            border-radius: 8px;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- NAVBAR MODERN (DISAMAKAN DENGAN DASHBOARD) -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm py-3">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/dashboard">
                <i class="bi bi-cpu-fill text-primary"></i> IT Support & Asset
            </a>
            <div class="d-flex align-items-center text-light gap-3">
                <% if (user) { %>
                    <div class="d-none d-md-block text-end">
                        <div class="fw-semibold small lh-1"><%= user.nama %></div>
                        <span class="text-muted" style="font-size: 0.75rem;"><%= user.departemen %> &bull; <span class="text-uppercase text-info"><%= user.role %></span></span>
                    </div>
                    <a href="/logout" class="btn btn-outline-light btn-sm px-3 d-flex align-items-center gap-1">
                        <i class="bi bi-box-arrow-right"></i> Keluar
                    </a>
                <% } %>
            </div>
        </div>
    </nav>

    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-7">
                <div class="card p-4">
                    <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
                        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3 me-3">
                            <i class="bi bi-ticket-perforated fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-1">Buat Tiket Bantuan / Pengadaan IT</h5>
                            <p class="text-muted small mb-0">Isi form di bawah ini agar kendala Anda tercatat resmi di sistem IT Support.</p>
                        </div>
                    </div>

                    <form action="/tickets" method="POST">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Kategori Masalah / Request</label>
                                <select name="kategori" class="form-select" required>
                                    <option value="Hardware">Hardware (Laptop/Printer/Mouse)</option>
                                    <option value="Software">Software / Instalasi Aplikasi</option>
                                    <option value="Jaringan/Internet">Jaringan / WiFi / VPN</option>
                                    <option value="Pengadaan Baru">Request Pengadaan Barang Baru</option>
                                    <option value="Lainnya">Lainnya</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Tingkat Urgensi</label>
                                <select name="prioritas" class="form-select" required>
                                    <option value="Low">Low (Tidak mendesak)</option>
                                    <option value="Medium" selected>Medium (Normal)</option>
                                    <option value="High">High (Menghambat kerja)</option>
                                    <option value="Urgent">Urgent (Operasional berhenti)</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Judul Singkat Kendala</label>
                            <input type="text" name="judul" class="form-control" placeholder="Contoh: Laptop tidak bisa connect WiFi kantor" required>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold small">Detail Kendala / Kebutuhan</label>
                            <textarea name="deskripsi" rows="4" class="form-control" placeholder="Jelaskan kronologi atau spesifikasi perangkat yang dibutuhkan..." required></textarea>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a href="/dashboard" class="btn btn-light border px-4">Kembali</a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">Kirim Tiket</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
<%- include('partials/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>